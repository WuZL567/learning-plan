# 复制这个文件：cp .env.example .env，然后把 sk-xxx 换成你自己的 Key
# .env 已被 .gitignore 忽略，不会被提交到 git

# ---- 对话模型（DeepSeek）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 向量化 / Embedding（硅基流动 BAAI/bge-m3）----
# 和上面的 Key 不是同一个，要单独注册：https://cloud.siliconflow.cn
# 注：bge-m3 是免费模型，1024 维，单次最长 8K tokens
#     这一把 Key 后面做 Reranking（11.4.15）也是同一个平台，可以直接复用
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
